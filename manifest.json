{
  "manifest_version": 3,
  "name": "Aria",
  "version": "0.1.0",
  "description": "A non-linear voice browser. Operate any web page by voice, with the screen off.",
  "permissions": ["offscreen", "storage", "tts", "tabs", "scripting", "bookmarks"],
  "host_permissions": ["<all_urls>"],
  "options_page": "src/pages/options.html",
  "background": {
    "service_worker": "src/sw/index.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/pages/mic.html"],
      "matches": ["<all_urls>"]
    }
  ]
}

