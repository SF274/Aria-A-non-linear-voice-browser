{
  "manifest_version": 3,
  "name": "ECHO — voice browser",
  "version": "0.1.0",
  "description": "Operate any web page by voice, with the screen off.",
  "permissions": ["offscreen", "storage", "tts", "tabs", "scripting", "bookmarks"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/sw/index.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
