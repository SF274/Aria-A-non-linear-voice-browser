# Copy to .env. Never commit .env.
# The Gemini API key is NOT here. It is entered in the extension options page
# and stored in chrome.storage.local (SPEC 8.6).

VITE_DEFAULT_GEMINI_MODEL=gemini-3.1-flash-lite
VITE_SEARCH_TEMPLATE=https://www.google.com/search?q=%s

# F-18 only, left blank until the Convex deployment exists
VITE_CONVEX_URL=

# F-19 only. Build-time script exclusively. Never referenced from src/.
COHERE_API_KEY=

# F-22 only. Build-time script exclusively (pnpm gate:gptzero). Never referenced from src/.
# The extension takes its GPTZero key from the options page, like the Gemini key (SPEC 8.6).
GPT_ZERO=
