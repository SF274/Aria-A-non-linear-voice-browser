{
  "name": "echo-voice-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run test/unit",
    "test:dom": "vitest run test/dom",
    "test": "vitest run test/unit test/dom",
    "test:e2e": "playwright test",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:e2e",
    "demo": "vite demo"
  },
  "dependencies": {
    "aria-query": "^5.3.2",
    "dom-accessibility-api": "^0.7.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/aria-query": "^5.0.4",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
